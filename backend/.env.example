# Copy to backend/.env. No Higgsfield credentials go here: each user saves their own
# key ID + secret from the web UI; it is stored encrypted in the database.

# Fernet key for encrypting saved API keys. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to auto-create backend/data/secret.key (local dev only).
APP_ENCRYPTION_KEY=

# Optional: public HTTPS URL of this backend (e.g. a tunnel) to receive Higgsfield
# webhooks. Without it, the built-in background poller is used.
PUBLIC_WEBHOOK_BASE_URL=

# Stop polling a job locally after N seconds (it is never auto-resubmitted).
GENERATION_TIMEOUT_SECONDS=2700

DATABASE_PATH=./data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
